{
  "name": "Bookshelf — Personal Book Tracker",
  "short_name": "Bookshelf",
  "description": "A calm, personal digital bookshelf for tracking what you read.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F1F2F4",
  "theme_color": "#78917B",
  "categories": ["books", "productivity", "lifestyle"],
  "icons": [
    {
      "src": "/static/images/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add a book",
      "short_name": "Add book",
      "description": "Search for a book or enter one manually.",
      "url": "/books/new",
      "icons": [
        {
          "src": "/static/images/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Currently reading",
      "short_name": "Reading",
      "description": "Jump back into your current books.",
      "url": "/books?status=currently_reading",
      "icons": [
        {
          "src": "/static/images/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
