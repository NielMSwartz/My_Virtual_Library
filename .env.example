# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values. Never commit the .env file.
# ---------------------------------------------------------------------------

# Flask
# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production; the app refuses to start with this placeholder.
SECRET_KEY=replace-with-a-long-random-string
FLASK_APP=run.py
FLASK_CONFIG=config.DevelopmentConfig
# On Render set FLASK_CONFIG=config.ProductionConfig

# Database. Leave unset to use SQLite at instance/book_tracker.db.
# Render injects DATABASE_URL automatically from the connected Postgres
# database. Both postgres:// and postgresql:// URLs are accepted.
# Example PostgreSQL value:
# DATABASE_URL=postgresql://user:password@localhost:5432/book_tracker

# Google Books works for basic search without a key. Add a key only if you
# want the higher quota associated with a Google Cloud project.
GOOGLE_BOOKS_API_KEY=

# Cache lifetime for online search results, in seconds (default: 7 days).
SEARCH_CACHE_TTL_SECONDS=604800

# Timeout for each external API request, in seconds.
REQUEST_TIMEOUT=8
